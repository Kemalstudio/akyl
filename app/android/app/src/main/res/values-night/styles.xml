    <!-- Фон окна под UI Flutter, пока он инициализируется. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/akyl_splash_background</item>
    </style>
</resources>
