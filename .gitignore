# Модели: вместе больше 200 МБ, скачиваются tools/fetch_models.ps1
models/
# Копия моделей для сборки APK — tools/fetch_models.ps1 кладёт их сюда
app/assets/models/
# Нативные библиотеки sherpa-onnx — tools/copy_sherpa_libs.ps1
app/packages/sherpa_onnx_android_arm64/android/src/main/jniLibs/

# Flutter / Dart
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/build/
app/coverage/
app/.pub-cache/
app/.pub/
**/*.iml

# Android
app/android/.gradle/
app/android/local.properties
app/android/app/debug/
app/android/key.properties
*.jks
*.keystore

# Python
__pycache__/
*.py[cod]
ml/.venv/
ml/data/
ml/runs/
ml/wandb/

# Среда разработки
.idea/
.vscode/
*.swp
.DS_Store

# Снимки, которые тест оставляет при расхождении
app/test/**/failures/

# Собранный APK: 48 МБ, в репозиторий не кладётся
*.apk
*.aab
